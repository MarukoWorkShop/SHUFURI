#!/bin/sh
# Commit message validator — lightweight, no deps required
# Allowed conventional commit types
TYPES="feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|merge"

MSG_FILE="$1"
MSG=$(cat "$MSG_FILE")

# Skip merge commits (auto-generated by git)
if echo "$MSG" | grep -qE '^Merge (branch|pull request|remote-tracking)'; then
  exit 0
fi

# Check conventional commit pattern: type: description
if echo "$MSG" | head -1 | grep -qE "^($TYPES)(\(.+\))?:\s.+"; then
  exit 0
fi

echo "--------------------------------------------------"
echo "  Invalid commit message format!"
echo ""
echo "  Expected: <type>: <description>"
echo "  Allowed types: feat, fix, docs, style, refactor,"
echo "                perf, test, build, ci, chore, revert"
echo ""
echo "  Examples:"
echo "    feat: add grammar cache with 6-dim hash"
echo "    fix: scroll broken on edit page"
echo "    docs: update AI explain design"
echo ""
echo "  Your message: $MSG"
echo "--------------------------------------------------"
exit 1
